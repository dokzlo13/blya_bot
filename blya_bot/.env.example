# =============================================================================
# blya_bot Production Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Environment variables use double underscore (__) as delimiter for nested keys

# =============================================================================
# Telegram Bot Settings (required)
# =============================================================================
TELEGRAM__BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# Command to trigger manual transcription (default: /t)
TELEGRAM__TRANSCRIBE_COMMAND="/t"

# Webhook settings (optional, for production deployments)
# Set to true to use webhooks instead of polling
TELEGRAM__USE_WEBHOOK=false
# TELEGRAM__WEBHOOK_URL="https://your-domain.com"
# TELEGRAM__WEBHOOK_PATH="/webhook"

# =============================================================================
# Service Settings
# =============================================================================
# Maximum voice/video duration in seconds (default: 300 = 5 minutes)
SERVICE__MY_NERVES_LIMIT=300

# Response when audio exceeds duration limit
SERVICE__POLITE_RESPONSE="Бот сломан, больше пяти минут войса ему не переварить"

# Ignore forwarded messages (default: true)
SERVICE__IGNORE_FORWARDED=true

# Log level: debug, info, warning, error (default: info)
SERVICE__LOG_LEVEL="info"

# Enable colored log output (default: false, set true for local dev)
SERVICE__LOG_COLORS=false

# Path to packed dictionary file (set by image)
# SERVICE__DICT_FILE="./fixtures/dict.bb"

# =============================================================================
# Speech Recognition Settings (required)
# =============================================================================
# Available engines: vosk, faster-whisper, pywhispercpp (set by image)
# RECOGNITION__ENGINE="vosk"

# Engine-specific options (JSON format, set by image)
# 
# For vosk:
# RECOGNITION__ENGINE_OPTIONS='{"model_path": "/app/models/vosk-model"}'
#
# For faster-whisper:
# RECOGNITION__ENGINE_OPTIONS='{"model": "small", "language": "ru", "device": "cpu", "compute_type": "int8", "beam_size": 5}'
#
# For faster-whisper with CUDA:
# RECOGNITION__ENGINE_OPTIONS='{"model": "small", "language": "ru", "device": "cuda", "compute_type": "float16", "beam_size": 5}'
#
# For pywhispercpp:
# RECOGNITION__ENGINE_OPTIONS='{"model": "small", "language": "ru"}'

# =============================================================================
# Health Check Settings (for container orchestration)
# =============================================================================
HEALTH_CHECK__HOST="0.0.0.0"
HEALTH_CHECK__PORT=8080
HEALTH_CHECK__PATH="/health/live"

# =============================================================================
# Cache Settings (optional, recommended for production)
# =============================================================================
# Available engines: sqlite, memory, or leave empty to disable
CACHE__ENGINE="sqlite"

# Cache parameters (JSON format)
# For sqlite:
CACHE__PARAMS='{"db_path": "/path/to/transcription_cache.db"}'
# For memory:
# CACHE__PARAMS='{"ttl": 3600}'

# Periodic cache cleanup interval in seconds (optional)
CACHE__PERIODIC_CLEANUP=3600
